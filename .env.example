# ============================================================
# WeSpringAuthServer 环境变量示例
#
# 用法：
#   cp .env.example .env
#   然后按本地环境填写下方留空的项
#
# 说明：
#   - 本文件只包含配置键和安全的示例值，不含任何真实密钥或账号。
#   - 留空的项表示必须自行填写；生产环境尤其不要使用占位值。
#   - dev.sh 与 IDEA 的 EnvFile 都会加载 .env；值不要加引号（兼容性更好）。
#   - 变量来源：src/main/resources/application.yml / application-prod.yml。
# ============================================================

# ---------- 服务 ----------
SERVER_PORT=9000
SPRING_APPLICATION_NAME=wespring-auth-server
SPRING_PROFILES_ACTIVE=dev

# ---------- 数据库（PostgreSQL）----------
# dev profile 默认使用 127.0.0.1:5432/ruichuangqi_dev；prod 必须显式提供全部项
DB_HOST=localhost
DB_PORT=5432
DB_NAME=authserver
DB_USERNAME=postgres
DB_PASSWORD=
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=5
SQL_INIT_MODE=always

# ---------- 邮件（SMTP）----------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEBUG=false

# ---------- 授权服务器 / OIDC ----------
# 多端口本地调试时，dev.sh 会在未显式设置的情况下自动改为 http://localhost:<port>
AUTH_SERVER_ISSUER=http://localhost:9000
AUTH_SERVER_DEFAULT_CLIENT_ID=ruichuangqi-client
SPRING_SECURITY_DEBUG=false

# ---------- OAuth2 Cookie / Refresh Token ----------
OAUTH2_COOKIE_DOMAIN=
OAUTH2_COOKIE_SECURE=false
OAUTH2_COOKIE_SAME_SITE=Lax
OAUTH2_COOKIE_MAX_AGE=2592000
OAUTH2_COOKIE_MODE_ENABLED=true
OAUTH2_HIDE_CLIENT_SECRET=true
OAUTH2_REFRESH_TOKEN_STRATEGY=cookie

# ---------- 密码重置 ----------
PASSWORD_RESET_URL=http://localhost:3000/reset-password
PASSWORD_TOKEN_EXPIRE_HOURS=24

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,X-Requested-With,Origin
CORS_ALLOW_CREDENTIALS=true

# ---------- Web 客户端代理端点 ----------
# 注意：这里是 WebTokenController 使用的附加配置，与数据库 oauth2_registered_client 并不是同一来源
WEB_CLIENT_IDS=web-client
WEB_CLIENT_SECRETS=
WEB_CLIENT_TOKEN_ENDPOINT_URL=http://localhost:9000/oauth2/token

# ---------- JWT 签名密钥 ----------
JWT_KEYSTORE_PATH=classpath:keys/jwt-signing-keys.jks
JWT_KEYSTORE_PASSWORD=
JWT_KEY_ALIAS=jwt-signing-key
JWT_KEY_PASSWORD=

# ---------- 日志 ----------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_SECURITY=INFO
LOG_LEVEL_OAUTH2=INFO
LOG_LEVEL_OIDC=INFO
LOG_LEVEL_LOGOUT=INFO
LOG_LEVEL_SESSION=INFO
LOG_LEVEL_WEB=INFO
LOG_LEVEL_DISPATCHER=WARN
LOG_LEVEL_SESSION_FILTER=WARN
LOG_LEVEL_WEB_FILTER=WARN
LOG_LEVEL_APP=INFO
LOG_FILE_PATH=/var/log/auth-server/auth-server.log

# ---------- 授权 state 加密 ----------
AUTH_STATE_PASSWORD=
AUTH_STATE_SALT=

# ---------- 微信小程序 ----------
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
WECHAT_AES_KEY=
WECHAT_REDIRECT_URI=http://localhost:9000/wechat/callback

# ---------- 短信 ----------
# 可选：simulator / aliyun / huoshan
SMS_PROVIDER=simulator
SMS_CODE_LENGTH=6
SMS_CODE_EXPIRATION=5

# 仅用于本地/审核测试的固定验证码登录；生产必须设为 false
SMS_TEST_LOGIN_ENABLED=false
SMS_TEST_LOGIN_PHONE_NUMBER=
SMS_TEST_LOGIN_CODE=

# 阿里云短信（SMS_PROVIDER=aliyun）
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION=cn-hangzhou

# 火山引擎短信（SMS_PROVIDER=huoshan）
HUOSHAN_SMS_ACCESS_KEY_ID=
HUOSHAN_SMS_SECRET_KEY=
HUOSHAN_SMS_ENDPOINT=https://sms.volcengineapi.com
HUOSHAN_SMS_SIGN_NAME=
HUOSHAN_SMS_TEMPLATE_ID=
HUOSHAN_SMS_ACCOUNT=
HUOSHAN_SMS_REGION=cn-north-1

# ---------- 本地测试脚本辅助变量（非应用配置）----------
# scripts/ 下的 curl 脚本可能会用到
BASE_URL=http://localhost:9000
